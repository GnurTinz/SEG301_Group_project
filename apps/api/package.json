{
  "name": "@portal/api", "private": true, "type": "module", "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts", "build": "tsc -p tsconfig.json", "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit", "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3", "argon2": "^0.44.0", "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5", "dotenv": "^17.2.3", "entities": "^4.5.0", "express": "^5.1.0",
    "express-rate-limit": "^8.2.1", "express-session": "^1.18.2", "helmet": "^8.1.0",
    "multer": "^2.0.2", "pg": "^8.16.3", "sanitize-html": "^2.17.0", "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3", "@types/cors": "^2.8.19", "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2", "@types/multer": "^2.0.0", "@types/sanitize-html": "^2.16.0", "prisma": "6.19.3"
  }
}
