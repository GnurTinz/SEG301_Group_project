{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --include=optional",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://seg301-group-project.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://seg301-group-project.onrender.com/uploads/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://seg301-group-project.onrender.com/health/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)|assets/|covers/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
