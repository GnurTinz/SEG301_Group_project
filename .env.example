NODE_ENV=development
PORT=3001
# Render: HOST=0.0.0.0, TRUST_PROXY=1, WEB_ORIGIN=https://your-project.vercel.app
HOST=0.0.0.0
TRUST_PROXY=0
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal?schema=public
POSTGRES_USER=portal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=portal
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD_12_CHARS_MIN
UPLOAD_DIR=uploads
# Vercel API origin is configured in vercel.json rewrites; no frontend env required.
# Optional: isolated database name must end in _test. Defaults to portal_test on DATABASE_URL's server.
# TEST_DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal_test
